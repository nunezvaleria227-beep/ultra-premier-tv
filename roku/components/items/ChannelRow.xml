<?xml version="1.0" encoding="utf-8" ?>
<!-- Un canal en la lista de En vivo: número, logo en caja blanca y nombre. -->
<component name="ChannelRow" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="index" type="integer" onChange="onContent" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/items/ChannelRow.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <children>
    <Poster uri="pkg:/images/list_row.9.png" width="560" height="56" />
    <Label id="num" translation="[6,0]" width="36" height="56" horizAlign="right" vertAlign="center" color="0x8FA3D6FF">
      <Font role="font" uri="pkg:/fonts/InterDisplay-Medium.ttf" size="12" />
    </Label>
    <Poster uri="pkg:/images/logo_box.9.png" translation="[52,6]" width="44" height="44" />
    <Poster id="logo" translation="[55,9]" width="38" height="38" loadDisplayMode="scaleToFit" loadWidth="76" loadHeight="76" />
    <Label id="name" translation="[110,0]" width="400" height="56" vertAlign="center" color="0xF2F6FFFF">
      <Font role="font" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="16" />
    </Label>
    <Poster id="fav" uri="pkg:/images/star.png" translation="[524,18]" width="20" height="20" visible="false" />
  </children>
</component>
