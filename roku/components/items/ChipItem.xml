<?xml version="1.0" encoding="utf-8" ?>
<!-- Una categoría como pastilla inclinada (fila de categorías de En vivo, Películas y Series).
     La elegida va en azul; la enfocada en blanco con letras azules. -->
<component name="ChipItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="paint" />
    <field id="focusPercent" type="float" onChange="paint" />
    <field id="rowListHasFocus" type="boolean" onChange="paint" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/items/ChipItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <children>
    <Group id="chip" scaleRotateCenter="[84,16]">
      <Poster id="bg" uri="pkg:/images/chip_glass.9.png" translation="[-10,-10]" width="188" height="52" />
      <Label id="name" width="138" height="32" translation="[15,0]" horizAlign="center" vertAlign="center" color="0xB8C6ECFF">
        <Font role="font" uri="pkg:/fonts/InterDisplay-ExtraBoldItalic.ttf" size="12" />
      </Label>
    </Group>
  </children>
</component>
