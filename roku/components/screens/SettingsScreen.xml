<?xml version="1.0" encoding="utf-8" ?>
<!-- Ajustes: cuenta, control parental, PIN, subtítulos, borrar "Continuar viendo" y cerrar sesión. -->
<component name="SettingsScreen" extends="Group">
  <interface>
    <field id="event" type="assocarray" alwaysNotify="true" />
    <function name="focusScreen" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/SettingsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <children>
    <Poster uri="pkg:/images/bg_detail.jpg" width="1280" height="720" />
    <Poster uri="pkg:/images/ic_settings.png" translation="[48,87]" width="24" height="24" blendColor="0xF2F6FFFF" />
    <Label translation="[82,80]" width="500" height="38" vertAlign="center" color="0xF2F6FFFF" text="AJUSTES">
      <Font role="font" uri="pkg:/fonts/InterDisplay-BlackItalic.ttf" size="27" />
    </Label>
    <LabelList id="list" translation="[48,134]" itemSize="[780,50]" numRows="9" focusBitmapUri="pkg:/images/list_focus.9.png"
      color="0xF2F6FFFF" focusedColor="0xFFFFFFFF" vertFocusAnimationStyle="floatingFocus">
      <Font role="font" uri="pkg:/fonts/InterDisplay-SemiBold.ttf" size="17" />
      <Font role="focusedFont" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="17" />
    </LabelList>
    <Label id="status" translation="[48,610]" width="1184" height="60" wrap="true" color="0xB8C6ECFF">
      <Font role="font" uri="pkg:/fonts/InterDisplay-Medium.ttf" size="14" />
    </Label>
    <UltraTopBar id="topBar" active="more" />
  </children>
</component>
